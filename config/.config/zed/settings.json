// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_weight": 100.0,
  "buffer_font_family": ".ZedMono",
  "terminal": {
    "dock": "right",
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "project_panel": {
    "button": false,
  },
  "agent": {
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^morpho6\\b"
            }
          ]
        },
        "skill": {
          "default": "allow"
        },
        "move_path": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
  },
  "vim_mode": true,
  "vim": {
    "default_mode": "normal",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Frappé",
  },
  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",
  "scrollbar": {
    "axes": {
      "vertical": false,
      "horizontal": false,
    },
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium"
      },
      "type": "registry",
    },
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "command_aliases": {
    "tcl": "workspace::ToggleCenteredLayout",
  },
  "file_types": {
    "C": ["morpho"],
  },
}
