// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "project_panel": {
    "button": false,
  },
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
  },
  "vim_mode": true,
  "vim": {
    "default_mode": "normal",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark",
  },
  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",
  "scrollbar": {
    "axes": {
      "vertical": false,
      "horizontal": false,
    },
  },
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Islands Dark",
  },
  "experimental.theme_overrides": {
    "background": "#1e1e1e00",
  },
  "window.background_appearance": "transparent",
}
